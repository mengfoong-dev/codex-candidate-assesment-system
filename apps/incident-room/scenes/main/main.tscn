[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/presentation/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/room/incident_room.tscn" id="2_room"]
[ext_resource type="PackedScene" path="res://scenes/ui/title_screen.tscn" id="3_title"]
[ext_resource type="PackedScene" path="res://scenes/ui/browser_workspace.tscn" id="4_workspace"]
[ext_resource type="PackedScene" path="res://scenes/ui/office_layer.tscn" id="5_office"]
[ext_resource type="PackedScene" path="res://scenes/ui/notepad.tscn" id="6_notepad"]
[ext_resource type="PackedScene" path="res://scenes/ui/ide_console.tscn" id="7_ide"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="IncidentRoom" parent="." instance=ExtResource("2_room")]
visible = false

[node name="UI" type="CanvasLayer" parent="."]

[node name="Workspace" parent="UI" instance=ExtResource("4_workspace")]
visible = false
demo_mode = false
assistant_proxy_url = "https://senior-proxy-production-82cf.up.railway.app/api/assistant/chat"

[node name="OfficeLayer" parent="UI" instance=ExtResource("5_office")]
visible = false
senior_proxy_url = "https://senior-proxy-production-82cf.up.railway.app/api/senior/chat"

[node name="Notepad" parent="UI" instance=ExtResource("6_notepad")]
visible = false

[node name="IDEConsole" parent="UI" instance=ExtResource("7_ide")]
assistant_proxy_url = "https://senior-proxy-production-82cf.up.railway.app/api/assistant/chat"
backend_base_url = "https://vibeproof-backend-production.up.railway.app"

[node name="TitleScreen" parent="UI" instance=ExtResource("3_title")]
