# Senior NPC proxy — configuration template.
# Copy this file to ".env" and fill in your real key. ".env" is gitignored — NEVER commit it.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# Which provider to call: openai, anthropic, or deepseek
PROVIDER=openai

# Set the key that matches PROVIDER (leave the other blank).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Model id (optional — sensible default per provider if blank).
#   openai default:    gpt-4o-mini
#   anthropic default: claude-sonnet-4-5
#   deepseek default:  deepseek-v4-flash
MODEL=

# Local port. Railway injects its own PORT automatically, so leave this for local runs.
PORT=8080

# CORS: comma-separated allowed origins (the game's URL). Use * only for local dev.
# e.g. ALLOWED_ORIGINS=https://vibeproof-web-production.up.railway.app
ALLOWED_ORIGINS=*

# Sandboxed scenario test runner. Docker must be available on the proxy host.
TEST_RUNNER_IMAGE=vibeproof-code-runner:latest
TEST_TIMEOUT_MS=10000
