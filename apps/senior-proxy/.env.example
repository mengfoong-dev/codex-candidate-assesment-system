# Copy this file to .env and enter the real value locally. .env is gitignored.
# Do not place a key in a tracked file or a command that persists shell history.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# Railway supplies PORT. This is only for local development.
PORT=8080

# Comma-separated browser origins. Use * only for local development.
ALLOWED_ORIGINS=*
