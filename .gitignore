# Local in-progress agent timer state. Completed sessions are stored in sessions.csv.
docs/hackathon/codex-usage/active-session.json

# Isolated feature worktrees managed by Codex.
.worktrees/

# Generated Superpowers brainstorming companion state and temporary screens.
.superpowers/

# Personal Claude Code context for the backend engineer (not team-shared).
CLAUDE.local.md
AGENTS.local.md

# Environment secrets — never commit real API keys. Templates (.env.example) stay tracked.
.env
.env.local
**/.env
**/.env.local

# Vendored asset source archives — only the extracted files under assets/third_party are tracked.
*.zip

# Node dependencies & build output — never commit; reinstall via npm/pnpm.
node_modules/
dist/
.tsbuild/
*.tsbuildinfo

# fs-sandbox runtime (WORKSPACE_BACKEND=fs installs a Node toolchain here — generated, per ADR 0001).
.harness/

# Local tool caches (not team-shared).
.playwright-mcp/
.playwright-cli/
.firecrawl/

# Stray root-level scratch drops (screenshots, duplicate asset exports).
/vibeproof-live.png
/isometric_office*.glb
