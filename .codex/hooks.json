{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path ((git rev-parse --show-toplevel).Trim()) '.codex/hooks/fastapi-best-practices.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path ((git rev-parse --show-toplevel).Trim()) '.codex/hooks/fastapi-best-practices.ps1')\"",
            "timeout": 10,
            "statusMessage": "Loading FastAPI backend conventions"
          }
        ]
      }
    ]
  }
}
