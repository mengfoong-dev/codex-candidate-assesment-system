# Copy to backend/.env and fill in local values. NEVER commit .env or paste keys into shell history.

# --- HTTP / CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./vibeproof.db

# --- Live Cohere flows: simulation + primary grading panel ---
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# --- Grading fallback: disabled by default; only used if the Cohere panel is unavailable ---
AI_PANEL_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GRADER_MODEL=llama-3.3-70b-versatile
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_GRADER_MODEL=meta/llama-3.1-70b-instruct

# --- Email report delivery (Brevo SMTP relay). Leave EMAIL_SMTP_HOST blank to disable. ---
# EMAIL_SMTP_USER is the relay LOGIN (e.g. ...@smtp-brevo.com), which differs from EMAIL_ADDRESS
# (the verified From/sender). NEVER commit the real EMAIL_PASSWORD / SMTP key.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_PASSWORD=
EMAIL_ADDRESS=
