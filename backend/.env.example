# Copy to backend/.env and fill in. NEVER commit .env. No secrets are hardcoded anywhere.

# --- HTTP / CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./vibeproof.db

# --- Live Cohere flows: simulation + primary grading panel ---
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# --- Grading fallback: disabled by default; only used if the Cohere panel is unavailable ---
AI_PANEL_FALLBACK_ENABLED=false

# --- Candidate chat provider (Gemini) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite

# --- Grading fallback providers (both OpenAI-compatible -> one client, base-URL swap) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GRADER_MODEL=llama-3.3-70b-versatile

NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_GRADER_MODEL=meta/llama-3.1-70b-instruct
