# Copy to backend/.env and fill in. NEVER commit .env. No secrets are hardcoded anywhere.

# --- HTTP / CORS (frontend dev origins, comma-separated JSON list) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database (SQLite for the hackathon; Postgres later = change this string only) ---
DATABASE_URL=sqlite+aiosqlite:///./vibeproof.db

# --- Simulation Engine (Anthropic Sonnet) ---
ANTHROPIC_API_KEY=
SIM_MODEL=claude-sonnet-5

# --- Grading panel (both OpenAI-compatible → one client, base-URL swap) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GRADER_MODEL=llama-3.3-70b-versatile

NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_GRADER_MODEL=meta/llama-3.1-70b-instruct
